# Vertex AI (GCP) — replaces direct Gemini API key
# One-time setup: gcloud auth application-default login && gcloud config set project YOUR_PROJECT_ID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# OpenAI (embeddings + LLM failover)
OPENAI_API_KEY=your-openai-api-key
PINECONE_API_KEY=your-pinecone-api-key

# LLM failover (Vertex primary -> OpenAI fallback)
LLM_PRIMARY_MODEL=gemini-2.5-pro
# OpenAI failover model — must support tool-calling (agent uses it on failover).
# gpt-5.6-terra = balanced intelligence/cost (chosen). Alternatives: gpt-5.6 (sol, frontier), gpt-5.6-luna (cheap).
LLM_FALLBACK_MODEL=gpt-5.6-terra
LLM_FALLBACK_ENABLED=true
LLM_COOLDOWN_SECONDS=60
LLM_ALLOWED_FAILS=3

# Pinecone Settings
PINECONE_INDEX_NAME=fashion-rag
PINECONE_ENVIRONMENT=us-east-1

# Application Settings
APP_API_KEY=your-app-api-key
IMAGE_FOLDER_PATH=/path/to/images
DEFAULT_TOP_K=10

# Virtual Try-on
DEFAULT_MODEL_IMAGE_PATH=/path/to/model/image.png
TRYON_OUTPUT_DIR=generated_tryons
IMAGE_GENERATION_MODEL_NAME=gemini-2.5-flash

# Agent (v3.0)
AGENT_MODEL_NAME=gemini-2.5-pro
AGENT_RECURSION_LIMIT=10
AGENT_MAX_ASK_USER=3
AGENT_MAX_RESULTS=5
AGENT_MAX_TURNS=20
AGENT_DEFAULT_GENDER=women
AGENT_DEFAULT_OCCASION=casual
AGENT_REQUIRED_SEARCH_FIELDS=gender,occasion

# LangSmith observability (optional — remove or set LANGCHAIN_TRACING_V2=false to disable)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=ai-fashion-designer
